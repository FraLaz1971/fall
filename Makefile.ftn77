FC=ftn77
FD=slink
PGPLOT_DIR=C:\pgplot
PGPLOT_FONT=$(PGPLOT_DIR)
F95=ftn95
OEXT=.obj
EEXT=.exe
RM=del /Q /F
ROOT=
FFLAGS=
ROOT=
FDFLAGS=
LIBS=$(PGPLOT_DIR)\pgplot.lib
SRCS=common.f limits.f iostat.f endfile.f endf2unf.f readunf1.f append.f files.f sort.f in2files.f \
pi.f fun100.f fun101.f fun102.f readfun.f butterfly.f chaos.f euclid.f r2b.f taysin.f \
form001.f entry.f expand.f wrtdat.f formats.f tempfc.f bin.f circle_area001.f
OBJS = $(SRCS:.f=$(OEXT))
TARGETS = $(OBJS:$(OEXT)=$(EEXT)) tracker$(EEXT) entry002$(EEXT) external$(EEXT) stats001$(EEXT) dumpblkdata$(EEXT) readblkdata$(EEXT) \
calc_cmplx$(EEXT) exams_data$(EEXT) exams001$(EEXT) points$(EEXT) fibonacci$(EEXT) sin$(EEXT) temp$(EEXT) vectors$(EEXT) vectors2$(EEXT) \
books$(EEXT) books2$(EEXT) realss$(EEXT) reals_portable$(EEXT) fun_roots$(EEXT) endlessdo$(EEXT) cycle$(EEXT) select$(EEXT) \
select2$(EEXT) quadratic002$(EEXT) fibonacci002$(EEXT) reverse$(EEXT) odds$(EEXT) angles001$(EEXT)
.PHONY: all clean

all: $(OBJS) $(TARGETS)

%$(OEXT): %.f
	$(FC) $(FFLAGS) $<

%$(EEXT): %$(OEXT)
	$(FD) -OUT:$@ $^ $(LIBS) $(FDFLAGS)

randoms$(OEXT): randoms.f
	$(FC) $(FFLAGS) $<

tracker$(EEXT): tracker.f95
	$(F95) $< /LINK /o $@

entry002$(EEXT): entry002.f95
	$(F95) $< /LINK /o $@

external$(EEXT): external.f95
	$(F95) $< /LINK /o $@

calc_cmplx$(EEXT): calc_cmplx.f95
	$(F95) $< /LINK /o $@

exams_data$(EEXT): exams_data.f95 randoms$(OEXT)
	$(F95) $^ /LINK /o $@

exams001$(EEXT): exams001.f95
	$(F95) $< /LINK /o $@

points$(EEXT): points.f95
	$(F95) $< /LINK /o $@

sin$(EEXT): sin.f95
	$(F95) $< /LINK /o $@

temp$(EEXT): temp.f95
	$(F95) $< /LINK /o $@

vectors$(EEXT): vectors.f95
	$(F95) $< /LINK /o $@

vectors2$(EEXT): vectors2.f95
	$(F95) $< /LINK /o $@

fibonacci$(EEXT): fibonacci.f95
	$(F95) $< /LINK /o $@

fibonacci002$(EEXT): fibonacci002.f95
	$(F95) $< /LINK /o $@ $(LIBS) $(FDFLAGS)

books$(EEXT): books.f95
	$(F95) $< /LINK /o $@

books2$(EEXT): books2.f95
	$(F95) $< /LINK /o $@

realss$(EEXT): realss.f95
	$(F95) $< /LINK /o $@

cycle$(EEXT): cycle.f95
	$(F95) $< /LINK /o $@

reverse$(EEXT): reverse.f95 randoms$(OEXT)
	$(F95) $^ /LINK /o $@

odds$(EEXT): odds.f95 randoms$(OEXT)
	$(F95) $^ /LINK /o $@

select$(EEXT): select.f95
	$(F95) $< /LINK /o $@

select2$(EEXT): select2.f95
	$(F95) $< /LINK /o $@

angles001$(EEXT): angles001.f95
	$(F95) $< /LINK /o $@

quadratic002$(EEXT): quadratic002.f95
	$(F95) $< /LINK /o $@

reals_portable$(EEXT): reals_portable.f95
	$(F95) $< /LINK /o $@

endlessdo$(EEXT): endlessdo.f95
	$(F95) $< /LINK /o $@

fun_roots$(EEXT): fun_roots.f95
	$(F95) $< /LINK /o $@ $(LIBS) $(FDFLAGS)

stats001$(EEXT): stats001.f randoms$(OEXT)
	$(FC) $^ /LINK

blockdatas$(OEXT): blockdatas.f
	$(FC) $(FFLAGS) $<

dumpblkdata$(OEXT): dumpblkdata.f
	$(FC) $(FFLAGS) $<

dumpblkdata$(EEXT): dumpblkdata$(OEXT) blockdata$(OEXT)
	$(FD) -OUT:$@ $^ $(LIBS) $(FDFLAGS)

readblkdata$(OEXT): readblkdata.f
	$(FC) $(FFLAGS) $<

readblkdata$(EEXT): readblkdata$(OEXT) blockdata$(OEXT)
	$(FD) -OUT:$@ $^ $(LIBS) $(FDFLAGS)

clean:
	$(RM) $(OBJS) $(TARGETS) tracker$(EEXT) entry002$(EEXT) external$(EEXT) dumpblkdata$(EEXT) readblkdata$(EEXT) \
exams_data$(EEXT) exams001$(EEXT) points$(EEXT) fibonacci$(EEXT) sin$(EEXT) temp$(EEXT) vectors$(EEXT) vectors2$(EEXT) \
books$(EEXT) books2$(EEXT) realss$(EEXT) reals_portable$(EEXT) fun_roots$(EEXT) endlessdo$(EEXT) cycle$(EEXT) select$(EEXT) \
select2$(EEXT) quadratic002$(EEXT) fibonacci002$(EEXT) reverse$(EEXT) odds$(EEXT) angles001$(EEXT)

